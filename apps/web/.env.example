# Base de datos local (Homebrew PostgreSQL 16)
DATABASE_URL=postgres://localhost:5432/waifu_baker_dev
# Taller de arte (lectura de output/<lote>/log.jsonl por cards-build)
ART_DIR=/Users/koopa/Documents/Waifu Baker
# Patreon OAuth (crear en https://www.patreon.com/portal/registration/register-clients)
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
AUTH_SECRET=
# Desarrollo: permite login de prueba sin Patreon
DEV_LOGIN=1
AUTH_TRUST_HOST=true
# Ids de Patreon con acceso al panel, separados por comas
ADMIN_PATREON_IDS=
# Token de creador de Patreon (API v2: campaña, tiers y miembros)
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CREATOR_REFRESH_TOKEN=
PATREON_CAMPAIGN_ID=
# URL pública del sitio (enlaces absolutos y vistas previas en redes)
SITE_URL=http://localhost:3100
