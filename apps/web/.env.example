# Base de datos local (Homebrew PostgreSQL 16)
DATABASE_URL=postgres://localhost:5432/waifu_baker_dev
# Taller de arte (lectura de output/<lote>/log.jsonl por cards-build)
ART_DIR=/Users/koopa/Documents/Waifu Baker
# Patreon OAuth (crear en https://www.patreon.com/portal/registration/register-clients)
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
AUTH_SECRET=
# Desarrollo: permite login de prueba sin Patreon
DEV_LOGIN=1
AUTH_TRUST_HOST=true
# Ids de Patreon con acceso al panel, separados por comas
ADMIN_PATREON_IDS=
# Token de creador de Patreon (API v2: campaña, tiers y miembros)
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CREATOR_REFRESH_TOKEN=
PATREON_CAMPAIGN_ID=
# URL pública del sitio (enlaces absolutos y vistas previas en redes)
SITE_URL=http://localhost:3100
# Spec 001: secreto de los avisos (webhooks) de Patreon, se crea al registrar el webhook en el portal
PATREON_WEBHOOK_SECRET=
# Spec 001: sal para la clave del sobre de bienvenida (por defecto AUTH_SECRET)
ACCOUNT_HASH_SECRET=
# Spec 001 y 007: 1 activa las tareas periódicas (Patreon cada 6 h, cuentas vencidas y copia diaria)
SCHEDULER=1
# Spec 007: carpeta y clave (12+ caracteres) de las copias de seguridad cifradas
BACKUP_DIR=
BACKUP_PASSPHRASE=
# Spec 007: correo de contacto de las páginas legales (vacío = página de Patreon)
CONTACT_EMAIL=
PATREON_PAGE_URL=https://www.patreon.com/WaifuBaker
# Spec 007: Sentry (vacío = desactivado)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
